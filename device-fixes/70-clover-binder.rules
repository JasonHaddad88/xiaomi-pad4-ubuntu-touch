# clover: give the binder device nodes the permissions Android itself specifies.
#
# /android/ueventd.rc says:
#     /dev/binder      0666  root root
#     /dev/hwbinder    0666  root root
#     /dev/vndbinder   0666  root root
#
# On this port hwbinder and vndbinder came up as 0600, so any non-root process
# (apps run as uid 32011/phablet) could not open them. HIDL needs hwbinder, so
# IMapper::getService() failed inside the camera app, and Android's libui reacted
# with LOG_ALWAYS_FATAL("gralloc-mapper is missing") - an unconditional abort().
# The camera app therefore died with SIGABRT seconds after opening, while every
# library involved was present and correct.
#
# Added 2026-09-26. Delete this file (and the service) to revert.
KERNEL=="binder",    MODE="0666"
KERNEL=="hwbinder",  MODE="0666"
KERNEL=="vndbinder", MODE="0666"
