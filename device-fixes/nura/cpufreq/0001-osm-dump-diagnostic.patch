--- /dev/null
+++ b/drivers/soc/qcom/osm-dump.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Temporary diagnostic for SDM660 (clover): dump the Operating State Manager
+ * register state at boot. The register accesses are STRICTLY READ-ONLY.
+ *
+ * Getting the output off the device is the hard part:
+ *
+ *  - The display driver is a module (CONFIG_DRM_MSM=m), so at late_initcall
+ *    there is no framebuffer console. console=tty0 prints nowhere and a hang
+ *    is completely invisible - which is how v1 and v2 wasted a boot each.
+ *  - But clover reserves ramoops@9fe00000 with console-size=0x80000, and the
+ *    kernel has PSTORE_CONSOLE=y, so every printk is already being recorded
+ *    into persistent DRAM.
+ *  - The catch: escaping a hang needs a 10-second power-button hold, and that
+ *    drops DRAM power and wipes precisely the log we want.
+ *
+ * So this version ends in a deliberate panic(). With panic=10 on the cmdline
+ * the kernel resets itself warm, DRAM keeps its contents, the device boots
+ * from flash again on its own, and the whole dump is waiting in
+ * /sys/fs/pstore. If a register access aborts before that, the resulting oops
+ * is captured by the same mechanism.
+ *
+ * Offsets from downstream clk-cpu-osm.c (LineageOS, sdm660).
+ */
+
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/printk.h>
+#include <linux/delay.h>
+
+#define OSM_PWRCL_BASE		0x179c0000	/* A53 "pwrcl"  */
+#define OSM_PERFCL_BASE		0x179c2000	/* A73 "perfcl" */
+#define OSM_WIN_SIZE		0x2000
+
+#define OSM_VERSION_REG		0x0000
+#define OSM_ENABLE_REG		0x1004
+#define OSM_FREQ_REG		0x1154
+#define OSM_VOLT_REG		0x1158
+#define OSM_PERF_STATE_REG	0x1f10
+
+#define OSM_REG_SIZE		32
+#define OSM_TABLE_SIZE		40
+#define XO_KHZ			19200
+
+/* say it, let the console drain, then risk the access */
+static void __init say(const char *what, u32 off)
+{
+	pr_emerg("osm-dump: ABOUT TO READ %s (+0x%04x)\n", what, off);
+	mdelay(30);
+}
+
+static void __init osm_dump_cluster(const char *name, phys_addr_t base)
+{
+	void __iomem *p;
+	u32 enable;
+	int i;
+
+	pr_emerg("osm-dump: %s: ioremap(%pa, 0x%x)\n", name, &base, OSM_WIN_SIZE);
+	p = ioremap(base, OSM_WIN_SIZE);
+	if (!p) {
+		pr_emerg("osm-dump: %s: ioremap FAILED\n", name);
+		return;
+	}
+
+	say("VERSION", OSM_VERSION_REG);
+	pr_emerg("osm-dump: %s: VERSION = 0x%08x  <-- first read survived\n",
+		 name, readl_relaxed(p + OSM_VERSION_REG));
+
+	say("ENABLE", OSM_ENABLE_REG);
+	enable = readl_relaxed(p + OSM_ENABLE_REG);
+	pr_emerg("osm-dump: %s: ENABLE = 0x%08x -> OSM %s\n", name, enable,
+		 (enable & 1) ? "ENABLED" : "DISABLED");
+
+	say("PERF_STATE", OSM_PERF_STATE_REG);
+	pr_emerg("osm-dump: %s: PERF_STATE = 0x%08x\n", name,
+		 readl_relaxed(p + OSM_PERF_STATE_REG));
+
+	if (!(enable & 1)) {
+		pr_emerg("osm-dump: %s: OSM disabled - skipping LUT walk\n", name);
+		goto out;
+	}
+
+	say("LUT rows 0..39", OSM_FREQ_REG);
+	for (i = 0; i < OSM_TABLE_SIZE; i++) {
+		u32 off = i * OSM_REG_SIZE;
+		u32 freq = readl_relaxed(p + OSM_FREQ_REG + off);
+		u32 volt = readl_relaxed(p + OSM_VOLT_REG + off);
+		u32 lval = freq & 0xff;
+		u32 src = (freq >> 30) & 0x3;
+
+		pr_emerg("osm-dump: %s[%02d] freq=0x%08x volt=0x%08x | src=%u lval=%3u -> %6u kHz, uv=%u\n",
+			 name, i, freq, volt, src, lval, lval * XO_KHZ,
+			 volt & 0xfff);
+	}
+
+out:
+	iounmap(p);
+	pr_emerg("osm-dump: %s: done\n", name);
+}
+
+static int __init osm_dump_init(void)
+{
+	pr_emerg("osm-dump: ======== SDM660 OSM state (v3) ========\n");
+	osm_dump_cluster("pwrcl-A53", OSM_PWRCL_BASE);
+	osm_dump_cluster("perfcl-A73", OSM_PERFCL_BASE);
+	pr_emerg("osm-dump: ======== all reads survived ========\n");
+
+	/*
+	 * Deliberate. panic=10 then resets the SoC warm, which keeps DRAM
+	 * powered so the ramoops console buffer holding everything above
+	 * survives into /sys/fs/pstore. Escaping by power button would wipe it.
+	 */
+	mdelay(200);
+	panic("osm-dump: finished - rebooting warm to preserve ramoops");
+	return 0;
+}
+late_initcall(osm_dump_init);
