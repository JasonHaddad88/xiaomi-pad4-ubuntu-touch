index 000000000..1ae137123
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sdm660-cprh-osm.dtsi
@@ -0,0 +1,469 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * SDM660 CPU DVFS: CPRh voltage controllers, OSM (cpufreq-hw), L2 SAW AVS
+ * ports, CPR fuse cells and CPRh virtual corners.
+ *
+ * Taken verbatim from the CPU-DVFS hunks of the HiBy RS6 series, patch 0041
+ * (github.com/noas-slopware/linux-hiby-rs6, Noa Himesaka). The idle, GPU,
+ * display and watchdog parts of that patch are deliberately left out.
+ * Every value here was checked against clover's Android device tree and
+ * vendor kernel: docs/nura-hiby-cprh-review.md.
+ *
+ * All nodes are disabled; a board enables them.
+ */
+
+&soc {
+	/*
+	 * L2 SAW4 AVS ports: CPRh voltage requests reach the PMIC through
+	 * them.  AVS_CTL/AVS_LIMIT come from the spm driver data, which
+	 * matches the vendor qcom,saw2-avs-{ctl,limit}.
+	 */
+	saw_gold_l2: power-manager@17812000 {
+		compatible = "qcom,sdm660-gold-saw2-v4.1-l2", "qcom,saw2";
+		reg = <0x17812000 0x1000>;
+		status = "disabled";
+	};
+
+	saw_silver_l2: power-manager@17912000 {
+		compatible = "qcom,sdm660-silver-saw2-v4.1-l2", "qcom,saw2";
+		reg = <0x17912000 0x1000>;
+		status = "disabled";
+	};
+
+	cpufreq_hw: cpufreq@179c0000 {
+		compatible = "qcom,sdm660-cpufreq-hw";
+		reg = <0x179c0000 0x1000>, <0x179c1000 0x1000>,
+		      <0x179c2000 0x1000>, <0x179c3000 0x1000>;
+		reg-names = "osm-domain0", "freq-domain0",
+			    "osm-domain1", "freq-domain1";
+
+		clocks = <&rpmcc RPM_SMD_XO_A_CLK_SRC>,
+			 <&gcc HMSS_GPLL0_CLK_SRC>;
+		clock-names = "xo", "alternate";
+
+		/* OSM LUT index 0 runs from this 300 MHz source */
+		assigned-clocks = <&gcc HMSS_GPLL0_CLK_SRC>;
+		assigned-clock-rates = <300000000>;
+
+		#freq-domain-cells = <1>;
+		#clock-cells = <1>;
+		status = "disabled";
+	};
+
+	/* reg[0] = apc0 (power cluster), reg[1] = apc1 (performance cluster) */
+	apc_cprh: power-controller@179c8000 {
+		compatible = "qcom,sdm660-cprh";
+		reg = <0x179c8000 0x4000>, <0x179c4000 0x4000>;
+
+		clocks = <&gcc GCC_HMSS_RBCPR_CLK>;
+		clock-names = "ref";
+		assigned-clocks = <&gcc GCC_HMSS_RBCPR_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		operating-points-v2 = <&cprh_opp_table>;
+		power-domains = <&rpmpd SDM660_VDDCX_AO>;
+		#power-domain-cells = <1>;
+
+		nvmem-cells = <&cpr_efuse_speedbin>,
+			      <&cpr_fuse_revision>,
+			      <&cpr_quot0_pwrcl>,
+			      <&cpr_quot1_pwrcl>,
+			      <&cpr_quot2_pwrcl>,
+			      <&cpr_quot3_pwrcl>,
+			      <&cpr_quot4_pwrcl>,
+			      <&cpr_qoff1_pwrcl>,
+			      <&cpr_qoff2_pwrcl>,
+			      <&cpr_qoff3_pwrcl>,
+			      <&cpr_qoff4_pwrcl>,
+			      <&cpr_ivolt0_pwrcl>,
+			      <&cpr_ivolt1_pwrcl>,
+			      <&cpr_ivolt2_pwrcl>,
+			      <&cpr_ivolt3_pwrcl>,
+			      <&cpr_ivolt4_pwrcl>,
+			      <&cpr_rosel0_pwrcl>,
+			      <&cpr_rosel1_pwrcl>,
+			      <&cpr_rosel2_pwrcl>,
+			      <&cpr_rosel3_pwrcl>,
+			      <&cpr_rosel4_pwrcl>,
+			      <&cpr_quot0_perfcl>,
+			      <&cpr_quot1_perfcl>,
+			      <&cpr_quot2_perfcl>,
+			      <&cpr_quot3_perfcl>,
+			      <&cpr_quot4_perfcl>,
+			      <&cpr_qoff1_perfcl>,
+			      <&cpr_qoff2_perfcl>,
+			      <&cpr_qoff3_perfcl>,
+			      <&cpr_qoff4_perfcl>,
+			      <&cpr_ivolt0_perfcl>,
+			      <&cpr_ivolt1_perfcl>,
+			      <&cpr_ivolt2_perfcl>,
+			      <&cpr_ivolt3_perfcl>,
+			      <&cpr_ivolt4_perfcl>,
+			      <&cpr_rosel0_perfcl>,
+			      <&cpr_rosel1_perfcl>,
+			      <&cpr_rosel2_perfcl>,
+			      <&cpr_rosel3_perfcl>,
+			      <&cpr_rosel4_perfcl>;
+
+		nvmem-cell-names = "cpr_speed_bin",
+				   "cpr_fuse_revision",
+				   "cpr0_quotient1",
+				   "cpr0_quotient2",
+				   "cpr0_quotient3",
+				   "cpr0_quotient4",
+				   "cpr0_quotient5",
+				   "cpr0_quotient_offset2",
+				   "cpr0_quotient_offset3",
+				   "cpr0_quotient_offset4",
+				   "cpr0_quotient_offset5",
+				   "cpr0_init_voltage1",
+				   "cpr0_init_voltage2",
+				   "cpr0_init_voltage3",
+				   "cpr0_init_voltage4",
+				   "cpr0_init_voltage5",
+				   "cpr0_ring_osc1",
+				   "cpr0_ring_osc2",
+				   "cpr0_ring_osc3",
+				   "cpr0_ring_osc4",
+				   "cpr0_ring_osc5",
+				   "cpr1_quotient1",
+				   "cpr1_quotient2",
+				   "cpr1_quotient3",
+				   "cpr1_quotient4",
+				   "cpr1_quotient5",
+				   "cpr1_quotient_offset2",
+				   "cpr1_quotient_offset3",
+				   "cpr1_quotient_offset4",
+				   "cpr1_quotient_offset5",
+				   "cpr1_init_voltage1",
+				   "cpr1_init_voltage2",
+				   "cpr1_init_voltage3",
+				   "cpr1_init_voltage4",
+				   "cpr1_init_voltage5",
+				   "cpr1_ring_osc1",
+				   "cpr1_ring_osc2",
+				   "cpr1_ring_osc3",
+				   "cpr1_ring_osc4",
+				   "cpr1_ring_osc5";
+
+		status = "disabled";
+	};
+};
+
+/*
+ * CPU DVFS: CPR-Hardened (KBSS) voltage controllers and the Operating State
+ * Manager, programmed by the OS.  The fuse layout below is the vendor
+ * kernel's (cprh-kbss-regulator.c: kbss_speed_bin_param,
+ * sdm660_cpr_fusing_rev_param, sdm660_kbss_{target_quot,quot_offset,
+ * init_voltage,ro_sel}_param), relative to qfprom@780000.  cpr0 = power
+ * (silver) cluster, cpr1 = performance (gold) cluster.
+ */
+&qfprom {
+	/* kbss_speed_bin_param: row 38 bits 29-31 */
+	cpr_efuse_speedbin: cpr-speedbin@4133 {
+		reg = <0x4133 0x1>;
+		bits = <5 3>;
+	};
+
+	/* sdm660_cpr_fusing_rev_param: row 71 bits 28-30 */
+	cpr_fuse_revision: cpr-fusing-rev@423b {
+		reg = <0x423b 0x1>;
+		bits = <4 3>;
+	};
+
+	/* sdm660_kbss_target_quot_param[0][0]: row 68 bits 12-23 */
+	cpr_quot0_pwrcl: quot0-pwrcl@4221 {
+		reg = <0x4221 0x2>;
+		bits = <4 12>;
+	};
+
+	/* sdm660_kbss_target_quot_param[0][1]: row 68 bits 0-11 */
+	cpr_quot1_pwrcl: quot1-pwrcl@4220 {
+		reg = <0x4220 0x2>;
+		bits = <0 12>;
+	};
+
+	/* sdm660_kbss_target_quot_param[0][2]: row 71 bits 9-20 */
+	cpr_quot2_pwrcl: quot2-pwrcl@4239 {
+		reg = <0x4239 0x2>;
+		bits = <1 12>;
+	};
+
+	/* sdm660_kbss_target_quot_param[0][3]: row 67 bits 52-63 */
+	cpr_quot3_pwrcl: quot3-pwrcl@421e {
+		reg = <0x421e 0x2>;
+		bits = <4 12>;
+	};
+
+	/* sdm660_kbss_target_quot_param[0][4]: row 67 bits 40-51 */
