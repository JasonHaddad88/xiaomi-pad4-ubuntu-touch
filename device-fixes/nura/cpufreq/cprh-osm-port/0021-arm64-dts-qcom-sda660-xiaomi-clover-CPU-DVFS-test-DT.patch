index 000000000..2eaf7c98b
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sda660-xiaomi-clover-cpufreq-bin0.dtsi
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi Mi Pad 4 (clover): CPU DVFS for speed bin 0.
+ * CPU OPP rows generated from clover's own Android OSM tables
+ * qcom,{pwrcl,perfcl}-speedbin0-v0: opp-hz = column 1, pll-override =
+ * column 3, spare-data = column 4, required CPRh corner = column 5,
+ * pll-div = freq_data bits 25:24. Voltages are NOT here: the CPRh
+ * driver computes them per chip from the fuses.
+ *
+ * cpu0-3 = cpu@100-103 = gold (perfcl, OSM domain 1, CPRh thread 1),
+ * cpu4-7 = cpu@0-3 = silver (pwrcl, OSM domain 0, CPRh thread 0).
+ * The CPUs have no PSCI power domain on this kernel, so the CPRh one
+ * is the only entry; the driver finds it by its "cpr" name.
+ */
+
+/ {
+	pwrcl_opp_table: opp-table-pwrcl {
+		compatible = "operating-points-v2-qcom-osm";
+		opp-shared;
+
+		opp-300000000 {
+			opp-hz = /bits/ 64 <300000000>;
+			required-opps = <&cprh_opp1>;
+			qcom,pll-override = <0x1200020>;
+			qcom,spare-data = <1>;
+		};
+
+		opp-633600000 {
+			opp-hz = /bits/ 64 <633600000>;
+			required-opps = <&cprh_opp2>;
+			qcom,pll-override = <0x3200020>;
+			qcom,spare-data = <1>;
+			qcom,pll-div = <1>;
+		};
+
+		opp-902400000 {
+			opp-hz = /bits/ 64 <902400000>;
+			required-opps = <&cprh_opp3>;
+			qcom,pll-override = <0x4260026>;
+			qcom,spare-data = <1>;
+		};
+
+		opp-1113600000 {
+			opp-hz = /bits/ 64 <1113600000>;
+			required-opps = <&cprh_opp4>;
+			qcom,pll-override = <0x52e002e>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-1401600000 {
+			opp-hz = /bits/ 64 <1401600000>;
+			required-opps = <&cprh_opp5>;
+			qcom,pll-override = <0x73a003a>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-1536000000 {
+			opp-hz = /bits/ 64 <1536000000>;
+			required-opps = <&cprh_opp6>;
+			qcom,pll-override = <0x8400040>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-1747200000 {
+			opp-hz = /bits/ 64 <1747200000>;
+			required-opps = <&cprh_opp7>;
+			qcom,pll-override = <0x9480048>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-1843200000 {
+			opp-hz = /bits/ 64 <1843200000>;
+			required-opps = <&cprh_opp8>;
+			qcom,pll-override = <0x94c004c>;
+			qcom,spare-data = <3>;
+		};
+	};
+
+	perfcl_opp_table: opp-table-perfcl {
+		compatible = "operating-points-v2-qcom-osm";
+		opp-shared;
+
+		opp-300000000 {
+			opp-hz = /bits/ 64 <300000000>;
+			required-opps = <&cprh_opp1>;
+			qcom,pll-override = <0x1200020>;
+			qcom,spare-data = <1>;
+		};
+
+		opp-1113600000 {
+			opp-hz = /bits/ 64 <1113600000>;
+			required-opps = <&cprh_opp2>;
+			qcom,pll-override = <0x52e002e>;
+			qcom,spare-data = <1>;
+		};
+
+		opp-1401600000 {
+			opp-hz = /bits/ 64 <1401600000>;
+			required-opps = <&cprh_opp3>;
+			qcom,pll-override = <0x73a003a>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-1747200000 {
+			opp-hz = /bits/ 64 <1747200000>;
+			required-opps = <&cprh_opp4>;
+			qcom,pll-override = <0x9480048>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-1958400000 {
+			opp-hz = /bits/ 64 <1958400000>;
+			required-opps = <&cprh_opp5>;
+			qcom,pll-override = <0xa510051>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-2150400000 {
+			opp-hz = /bits/ 64 <2150400000>;
+			required-opps = <&cprh_opp6>;
+			qcom,pll-override = <0xb590059>;
+			qcom,spare-data = <2>;
+		};
+
+		opp-2457600000 {
+			opp-hz = /bits/ 64 <2457600000>;
+			required-opps = <&cprh_opp7>;
+			qcom,pll-override = <0xc660066>;
+			qcom,spare-data = <3>;
+		};
+	};
+};
+
+&cpu0 {
+	operating-points-v2 = <&perfcl_opp_table>;
+	power-domains = <&apc_cprh 1>;
+	power-domain-names = "cpr";
+	qcom,freq-domain = <&cpufreq_hw 1>;
+};
+
+&cpu1 {
+	operating-points-v2 = <&perfcl_opp_table>;
+	power-domains = <&apc_cprh 1>;
+	power-domain-names = "cpr";
+	qcom,freq-domain = <&cpufreq_hw 1>;
+};
+
+&cpu2 {
+	operating-points-v2 = <&perfcl_opp_table>;
+	power-domains = <&apc_cprh 1>;
+	power-domain-names = "cpr";
+	qcom,freq-domain = <&cpufreq_hw 1>;
+};
+
+&cpu3 {
+	operating-points-v2 = <&perfcl_opp_table>;
+	power-domains = <&apc_cprh 1>;
+	power-domain-names = "cpr";
+	qcom,freq-domain = <&cpufreq_hw 1>;
+};
+
+&cpu4 {
+	operating-points-v2 = <&pwrcl_opp_table>;
+	power-domains = <&apc_cprh 0>;
+	power-domain-names = "cpr";
+	qcom,freq-domain = <&cpufreq_hw 0>;
+};
+
+&cpu5 {
+	operating-points-v2 = <&pwrcl_opp_table>;
+	power-domains = <&apc_cprh 0>;
+	power-domain-names = "cpr";
+	qcom,freq-domain = <&cpufreq_hw 0>;
+};
+
+&cpu6 {
+	operating-points-v2 = <&pwrcl_opp_table>;
+	power-domains = <&apc_cprh 0>;
+	power-domain-names = "cpr";
+	qcom,freq-domain = <&cpufreq_hw 0>;
+};
+
+&cpu7 {
+	operating-points-v2 = <&pwrcl_opp_table>;
+	power-domains = <&apc_cprh 0>;
+	power-domain-names = "cpr";
+	qcom,freq-domain = <&cpufreq_hw 0>;
+};
+
+&apc_cprh {
+	status = "okay";
+};
+
+&cpufreq_hw {
+	status = "okay";
+};
+
+&saw_gold_l2 {
+	status = "okay";
+};
+
+&saw_silver_l2 {
+	status = "okay";
+};
