 dtb-$(CONFIG_ARCH_QCOM)	+= sc8280xp-microsoft-blackrock.dtb sc8280xp-microsoft-blackrock-el2.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sda660-inforce-ifc6560.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sda660-xiaomi-clover.dtb
-dtb-$(CONFIG_ARCH_QCOM)	+= sda660-xiaomi-clover-cpufreq-bin0.dtb
-dtb-$(CONFIG_ARCH_QCOM)	+= sda660-xiaomi-clover-cpufreq-bin1.dtb
-dtb-$(CONFIG_ARCH_QCOM)	+= sda660-xiaomi-clover-cpufreq-bin3.dtb
-dtb-$(CONFIG_ARCH_QCOM)	+= sda660-xiaomi-clover-cpufreq-bin4.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sdm450-lenovo-tbx605f.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sdm450-motorola-ali.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sdm630-nokia-pl2.dtb
