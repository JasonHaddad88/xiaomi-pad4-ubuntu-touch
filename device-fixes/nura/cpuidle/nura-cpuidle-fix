#!/bin/sh
# Disable the PSCI idle states clover's firmware rejects.
#
# The DT describes core retention (cpu-sleep-N-0) and three cluster states
# (cluster-sleep-*) in PSCI platform-coordinated form, but the firmware
# refuses them ("psci: [Firmware Bug]: failed to set PC mode: -3" at boot).
# cpuidle keeps picking them, the call returns at once, and idle cores spin:
# ~3 million rejections per 30 s, and s2idle never actually sleeps.
# Core power collapse (cpu-sleep-N-1) and WFI work and stay enabled.
#
# Measured 2026-11-03: system draw 1574 -> 1133 mW with the screen on.
# Undo: systemctl disable --now nura-cpuidle-fix.service
v=${1:-1}
for d in /sys/devices/system/cpu/cpu[0-9]*/cpuidle/state[0-9]*; do
	case "$(cat "$d/name")" in
	cpu-sleep-[0-9]-0|cluster-sleep-*) echo "$v" > "$d/disable" ;;
	esac
done
