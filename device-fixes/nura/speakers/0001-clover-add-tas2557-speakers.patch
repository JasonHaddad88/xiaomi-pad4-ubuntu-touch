+&blsp_i2c6 {
+	status = "okay";
+
+	/*
+	 * Mi Pad 4 has a stereo pair of TAS2557 smart amplifiers, one per
+	 * speaker. Both are on this bus; the downstream kernel describes them
+	 * as a single "ti,tas2557s" node carrying ti,left-channel = <0x4c> and
+	 * ti,right-channel = <0x4e>, which the mainline driver instead models
+	 * as two independent codecs selected by ti,channel.
+	 *
+	 * Addresses and GPIOs were read from the downstream device tree on the
+	 * device itself (/proc/device-tree under Ubuntu Touch):
+	 *   ti,reset-gpio-left  = <&tlmm 80>   ti,irq-gpio-left  = <&tlmm 28>
+	 *   ti,reset-gpio-right = <&tlmm 48>   ti,irq-gpio-right = <&tlmm 55>
+	 *
+	 * sound-name-prefix is required because two instances of the same
+	 * codec would otherwise register colliding control and widget names
+	 * ("Speaker Playback Volume", "ASI1", "ASI2").
+	 */
+	tas2557_l: codec@4c {
+		compatible = "ti,tas2557";
+		reg = <0x4c>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Spk";
+
+		reset-gpios = <&tlmm 80 GPIO_ACTIVE_LOW>;
+		interrupts-extended = <&tlmm 28 IRQ_TYPE_LEVEL_HIGH>;
+
+		vbat-supply = <&vph_pwr>;
+
+		ti,channel = <0>;
+	};
+
+	tas2557_r: codec@4e {
+		compatible = "ti,tas2557";
+		reg = <0x4e>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Spk";
+
+		reset-gpios = <&tlmm 48 GPIO_ACTIVE_LOW>;
+		interrupts-extended = <&tlmm 55 IRQ_TYPE_LEVEL_HIGH>;
+
+		vbat-supply = <&vph_pwr>;
+
+		ti,channel = <1>;
+	};
+};
+
 &mdss {
 	status = "okay";
 };
