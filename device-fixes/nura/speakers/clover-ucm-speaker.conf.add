# UCM changes for clover's stereo TAS2557 speakers.
# These are the exact edits that were applied and tested on the device.
#
# Upstream: https://github.com/sdm660-mainline/alsa-ucm-conf
# Note that /usr/share/alsa/ucm2/conf.d/sdm660-internal/Xiaomi Mi Pad 4.conf and
# /usr/share/alsa/ucm2/Xiaomi/clover/clover.conf carry the same content and both
# point at the same HiFi.conf.


# ---- 1. append inside BootSequence, in clover.conf and "Xiaomi Mi Pad 4.conf" ----

	# Speakers (stereo TAS2557) - 0..15 maps to -28..+2 dB; 14 = 0 dB
	cset "name='Left Spk Speaker Playback Volume' 14"
	cset "name='Right Spk Speaker Playback Volume' 14"


# ---- 2. append to /usr/share/alsa/ucm2/Xiaomi/clover/HiFi.conf ----
#
# "Left Spk" / "Right Spk" are the sound-name-prefix values the device tree
# gives the two amps; without them two instances of one codec would register
# colliding control names.

SectionDevice."Speaker" {
	Comment "Built-in Speakers (stereo TAS2557 smart amplifiers)"

	EnableSequence [
		cset "name='PRI_MI2S_RX Audio Mixer MultiMedia1' 1"
	]

	DisableSequence [
		cset "name='PRI_MI2S_RX Audio Mixer MultiMedia1' 0"
	]

	ConflictingDevices [
		"Headphones"
	]

	Value {
		PlaybackPCM "hw:${CardId},0"
		PlaybackPriority 300
	}
}


# ---- 3. add to the existing Headphones device in HiFi.conf ----
#
# It had no ConflictingDevices block at all, because it was the only playback
# device that existed. That is also why the volume OSD read
# "Headphones (3.5 mm jack)" with nothing plugged in.

	ConflictingDevices [
		"Speaker"
	]
