From 623d4f7a59fcad4f2be8d6e516adf432f6e78977 Mon Sep 17 00:00:00 2001
From: clover porter <clover@localhost>
Date: Thu, 12 Nov 2026 22:43:57 +0200
Subject: [PATCH] wifi: ath10k: do not set the TXBF vdev param after vdev down
 on WCN3990

On disconnect mac80211 removes the AP station first, so ath10k deletes
the BSS peer, and then reports BSS_CHANGED_ASSOC. ath10k_bss_disassoc()
sends vdev down and then recalculates TXBF, which sets the TXBF vdev
parameter on a vdev that is down and has no BSS peer. The WCN3990
firmware (WLAN.HL 1.0.0.531 on SDM660) takes an exception in
wlan_process on that command, every time:

  wmi tlv peer delete
  wmi tlv vdev down
  wmi tlv vdev 0 set param 45 value 0x0
  qcom-q6v5-mss: fatal error received: err_qdi.c:459:EX:wlan_process:1:WLAN RT:...:PC=b00c7410

The vendor ath10k tree has the same fix ("ath10k: Fix STA disconnect
issue", CRs-Fixed 2000365): skip the recalculation on WCN3990. The
parameter is set again on the next association.
---
 drivers/net/wireless/ath/ath10k/mac.c | 17 ++++++++++++-----
 1 file changed, 12 insertions(+), 5 deletions(-)

diff --git a/drivers/net/wireless/ath/ath10k/mac.c b/drivers/net/wireless/ath/ath10k/mac.c
index 0558041e3..8c77e5f4a 100644
--- a/drivers/net/wireless/ath/ath10k/mac.c
+++ b/drivers/net/wireless/ath/ath10k/mac.c
@@ -3207,11 +3207,18 @@ static void ath10k_bss_disassoc(struct ieee80211_hw *hw,
 
 	arvif->def_wep_key_idx = -1;
 
-	ret = ath10k_mac_vif_recalc_txbf(ar, vif, vht_cap);
-	if (ret) {
-		ath10k_warn(ar, "failed to recalc txbf for vdev %i: %d\n",
-			    arvif->vdev_id, ret);
-		return;
+	/*
+	 * The WCN3990 firmware crashes when the TXBF vdev parameter is set
+	 * after vdev down: by now mac80211 has removed the AP station, so
+	 * the BSS peer is gone. The parameter is set again on association.
+	 */
+	if (!QCA_REV_WCN3990(ar)) {
+		ret = ath10k_mac_vif_recalc_txbf(ar, vif, vht_cap);
+		if (ret) {
+			ath10k_warn(ar, "failed to recalc txbf for vdev %i: %d\n",
+				    arvif->vdev_id, ret);
+			return;
+		}
 	}
 
 	arvif->is_up = false;
-- 
2.53.0

