<?xml version="1.0" encoding="UTF-8"?>
<!--
  clover (Xiaomi Mi Pad 4, WiFi) — Halium 9.0 local_manifest
  ==========================================================
  Install location (inside the Halium source tree, in WSL2):
      .repo/local_manifests/clover.xml

  Base : Halium 9.0   |   Rootfs target : Ubuntu Touch Noble (24.04)

  These three repos are the 2021 ubuntu-touch-clover port that already had
  touchscreen + display + GPU + the UI working — our fastest path to a first boot.
  We sync them read-only for the initial build. As soon as we start PATCHING the
  device tree / kernel, we fork these to our own GitHub and repoint `remote`/`revision`.

  Verify after `repo sync`:  `breakfast clover` should resolve with no missing repos.
  If the build complains about a missing sdm660-common tree, add it here.
-->
<manifest>
  <remote name="ubuntu-touch-clover"
          fetch="https://github.com/ubuntu-touch-clover"
          revision="halium-9.0" />

  <project path="device/xiaomi/clover" name="halium_device_xiaomi_clover" remote="ubuntu-touch-clover" />
  <project path="kernel/xiaomi/clover" name="halium_kernel_xiaomi_clover" remote="ubuntu-touch-clover" />
  <project path="vendor/xiaomi/clover" name="halium_vendor_xiaomi_clover" remote="ubuntu-touch-clover" />
</manifest>
